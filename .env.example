# SkillBridge Environment Configuration

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication
JWT_SECRET=skillbridge-super-secret-jwt-key-2026-production
JWT_EXPIRES_IN=7d

# Database (Optional - defaults to auto-persisted zero-setup store if empty)
MONGODB_URI=

# AI & OpenAI / Anthropic Integration (Optional)
OPENAI_API_KEY=

# File Storage (Optional Cloudinary / S3)
STORAGE_BUCKET=
STORAGE_REGION=
